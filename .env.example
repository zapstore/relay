# Relay configuration. Copy to .env, which stays out of git.
# An empty value keeps the default named in its comment.
# Names: _ADDRESS is host:port to listen on, _HOSTNAME a bare public host,
# _URL a full URL, _DIR a directory, _PATH a file, _INTERVAL/_TIMEOUT/_TTL a Go
# duration (30s, 5m, 24h), _BYTES a byte count, _SIZE an item count, and
# _PUBKEYS comma-separated 64-character hex public keys.

# ── System ───────────────────────────────────────────────────────────────────

# Required. Holds every database, blob, bundle, the model, and relay.sock:
# relay.db blossom.db artifacts.db analytics.db geo.mmdb blossom/ bundles/
# snapshots/ cache/ models/ relay.sock. Production: /var/lib/zapstore/data.
DATA_DIR=./data
# debug, info, warn, or error. Default: info.
LOG_LEVEL=
# true rejects events, uploads, and blacklist or whitelist changes. Bundles are
# still sealed. Default: false.
READ_ONLY=
# Required. May sign relay.sock commands. Keep equal to the webapp's ADMIN_PUBKEYS.
ADMIN_PUBKEYS=

# ── Catalog ──────────────────────────────────────────────────────────────────

# Required. The catalog signing key: 1 (generate), 64-character hex, nsec, or a
# hotbox bunker:// URL. Its public key is the relay's (see RELAY_PUBKEY).
SIGN_WITH=
# How often a new snapshot is sealed into a bundle. 0 disables the tick;
# `relay bundle` still seals one. Default: 5m.
CATALOG_BUNDLE_INTERVAL=

# ── Relay ────────────────────────────────────────────────────────────────────

# Required. Public hostname, checked in NIP-42 AUTH.
RELAY_HOSTNAME=localhost
# Default: localhost:3334.
RELAY_ADDRESS=
# Events queued for processing. Default: 1000.
RELAY_QUEUE_SIZE=
# Largest message a client may send. Default: 500000.
RELAY_MAX_MESSAGE_BYTES=
# Filters in one REQ. Default: 50.
RELAY_MAX_REQ_FILTERS=
# Responses buffered per connection before backpressure. Default: 500.
RELAY_RESPONSE_LIMIT=
# Comma-separated kinds the relay accepts.
# Default: 0,5,1059,1111,1984,3063,9735,10067,10222,30063,30078,30267,30509,32267.
RELAY_ALLOWED_EVENT_KINDS=
# How often pending events are checked for completeness. Default: 1m.
RELAY_RECONCILE_INTERVAL=
# A pending event older than this is deleted. Default: 5h.
RELAY_REMOVE_PENDING_AFTER=
# Comma-separated ws(s) URLs that resolve a publisher's kind 0.
# Default: wss://relay.vertexlab.io.
RELAY_PROFILE_RELAYS=
# relay.sock: admin commands, and NIP-01 for a connection that opens with '['.
# Default: DATA_DIR/relay.sock. Production sets it in the unit, under /run.
RELAY_SOCKET_PATH=

# ── Relay info (NIP-11) ──────────────────────────────────────────────────────

# The catalog key, hex or npub. Default: the SIGN_WITH public key. When set, it
# must equal that key.
RELAY_PUBKEY=
# NIP-11 fields. An empty one is logged at startup and does not stop it.
RELAY_NAME=Zapstore
RELAY_DESCRIPTION=The Zapstore relay
# The public wss:// URL.
RELAY_URL=
# A pubkey to contact.
RELAY_CONTACT=
RELAY_ICON=
RELAY_BANNER=
RELAY_SOFTWARE=https://github.com/zapstore/relay

# ── Rate limit (per IP) ──────────────────────────────────────────────────────

# Tokens a new IP starts with. Default: 100.
RATE_INITIAL_TOKENS=
# Most tokens an IP holds. Default: 300.
RATE_MAX_TOKENS=
# Tokens added every RATE_INTERVAL. Default: 100.
RATE_TOKENS_PER_INTERVAL=
# Default: 1m.
RATE_INTERVAL=

# ── Blossom ──────────────────────────────────────────────────────────────────

# Required. Public hostname, checked in upload auth and used in blob URLs.
BLOSSOM_HOSTNAME=localhost
# Default: localhost:3335.
BLOSSOM_ADDRESS=
# Comma-separated MIME types that may be uploaded.
# Default: application/vnd.android.package-archive and common image types.
BLOSSOM_ALLOWED_MEDIA=
# An upload with no progress for this long is dropped. Default: 30s.
BLOSSOM_STALL_TIMEOUT=
# How often unreferenced blobs are deleted, on Bunny and in DATA_DIR/blossom.
# 0 disables it. Default: 24h.
BLOSSOM_PRUNE_INTERVAL=

# Bunny CDN: all four of ZONE, ZONE_HOSTNAME, PASSWORD, and CDN_HOSTNAME, or none.
# None keeps every blob in DATA_DIR/blossom.
BLOSSOM_BUNNY_ZONE=
# Storage zone hostname, no scheme. Example: storage.bunnycdn.com.
BLOSSOM_BUNNY_ZONE_HOSTNAME=
# Storage zone password, at least 8 characters.
BLOSSOM_BUNNY_PASSWORD=
# Pull zone hostname, no scheme. Example: zapstore.b-cdn.net.
BLOSSOM_BUNNY_CDN_HOSTNAME=
# Ceiling for one Bunny request. Default: 20m.
BLOSSOM_BUNNY_REQUEST_TIMEOUT=

# ── Analytics ────────────────────────────────────────────────────────────────

# Analytics API address. Empty turns analytics off: no database, no collection,
# no API. Example: localhost:3336.
ANALYTICS_ADDRESS=
# Default: 5m.
ANALYTICS_FLUSH_INTERVAL=
# Default: 10s.
ANALYTICS_FLUSH_TIMEOUT=
# Events written in one transaction. Default: 1000.
ANALYTICS_FLUSH_SIZE=
# Events held in memory; more are dropped. Default: 100000.
ANALYTICS_QUEUE_SIZE=

# ── Vertex web of trust ──────────────────────────────────────────────────────

# Signs Vertex requests. Empty turns the check off: only the catalog key,
# whitelisted keys, and keys that already published may publish.
VERTEX_SECRET_KEY=
# globalPagerank, personalizedPagerank, or followerCount. Default: globalPagerank.
VERTEX_SORT=
# The source pubkey, required for personalizedPagerank.
VERTEX_SOURCE=
# A publisher's rank must be at or above it. Default: 0.000005.
VERTEX_THRESHOLD=
# Default: 10s.
VERTEX_REQUEST_TIMEOUT=
# Default: 1h.
VERTEX_CREDITS_POLL_INTERVAL=
# Below this many credits a warning is logged. Default: 500.
VERTEX_CREDITS_LOG_THRESHOLD=
# Default: 24h.
VERTEX_CACHE_TTL=
# Ranks held in memory. Default: 100000.
VERTEX_CACHE_SIZE=

# ── Enrichment (steroid, in this process) ────────────────────────────────────

# OpenAI-compatible provider. Enrichment fails without URL, key, and model.
LLM_URL=
LLM_API_KEY=
# Comma-separated: the model, then fallbacks on the same provider.
LLM_MODEL=
# A second provider tried after the first fails.
LLM_FALLBACK_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
# Fetches an APK missing from DATA_DIR/blossom: GET /<sha256>.
# Default: https://cdn.zapstore.dev.
BLOSSOM_URL=
# The leaf-ir-v1 model, downloaded on first use. Default: DATA_DIR/models/leaf-ir-v1.
LEAF_MODEL_DIR=
# The ONNX Runtime library. Default: downloaded next to the model, in DATA_DIR/models.
ONNXRUNTIME_LIB=
